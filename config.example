# claude-voice configuration
# Copy to ~/.config/claude-voice/config and edit. Every value is optional.

# 1 = speak, 0 = silent. Toggle voice mode off without uninstalling.
VOICE_ENABLED=1

# How the spoken line is produced — selects a strategy leaf in scripts/strategies/:
#   marker    = (default) speak only the agent's 🔊-prefixed final summary line; zero extra
#               LLM calls; full context for free. Claude Code only (relies on the
#               injected instruction — only the Claude Code plugin injects it).
#   summarize = one `claude -p` summary per response; works everywhere (incl. Codex);
#               no history. Tune cost with VOICE_SUMMARIZER (e.g. claude -p --model haiku).
#   rolling   = (stub) history-aware running-summary narration; currently falls back
#               to summarize.
VOICE_MODE=marker

# macOS TTS voice (`say -v`). Run `say -v '?'` to list. Empty = system default.
# Ignored on Linux (spd-say / espeak use the system default voice).
VOICE_NAME=Samantha

# Summarizer command for VOICE_MODE=summarize.
# Default reuses your Claude Code login — no separate API key.
#   VOICE_SUMMARIZER="claude -p"
VOICE_SUMMARIZER="claude -p"

# Max characters of the response fed to the summarizer (keeps it fast/cheap).
VOICE_MAX_CHARS=4000
